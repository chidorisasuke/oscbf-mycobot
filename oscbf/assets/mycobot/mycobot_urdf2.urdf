<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myco2urdf_asm">
  
  <link name="world" />
  <link name="base_link" />

  <joint name="world_to_base" type="fixed">
    <!-- <origin xyz="0 0 0.14511" rpy="-1.5708 0 0" /> -->
    <parent link="world" />
    <child link="base_link" />
  </joint>

  <joint name="base_to_link1" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" /> 
    <child link="link1" />
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="0.0016008 0.11511 0.0067458" rpy="0 0 0" />
      <mass value="0.16497" />
      <inertia ixx="0.00014206" ixy="1.9029E-07" ixz="-2.0029E-06"
               iyy="0.00011896" iyz="5.5548E-07" izz="0.00022346" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/joint1.obj" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/joint1.obj" />
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="link1">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <link name="link2">
    <inertial>
      <origin xyz="0.00714811777638832 0.000121608250632467 -0.0292419584156574" rpy="0 0 0" />
      <mass value="0.042737" />
      <inertia ixx="3.783E-05" ixy="-6.322E-09" ixz="1.0862E-05"
               iyy="3.7247E-05" iyz="1.7202E-08" izz="1.7525E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/joint2.obj" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/joint2.obj" />
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="link2">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  
  <link name="link3">
    <inertial>
      <origin xyz="0.0832924092392715 0.000652353914798558 0.05162733747398" rpy="0 0 0" />
      <mass value="0.066848" />
      <inertia ixx="0.00016702" ixy="1.6289E-09" ixz="-5.7421E-07"
               iyy="0.00015837" iyz="-2.5766E-08" izz="2.0606E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/joint3.obj" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/joint3.obj" />
      </geometry>
    </collision>
  </link>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
  
  <gazebo reference="link3">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <link name="link4">
    <inertial>
      <origin xyz="0.0297152075321264 0.00655328476393664 0.0432331834472588" rpy="0 0 0" />
      <mass value="0.053332" />
      <inertia ixx="0.0001016" ixy="3.7953E-11" ixz="-4.0387E-06"
               iyy="9.7393E-05" iyz="-5.4498E-09" izz="1.3694E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/joint4.obj" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/joint4.obj" />
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="link4">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <link name="link5">
    <inertial>
      <origin xyz="0.0815000525136791 0.0160219706521019 0.00900907181543537" rpy="0 0 0" />
      <mass value="0.024058" />
      <inertia ixx="7.7374E-06" ixy="-1.6019E-09" ixz="3.3102E-06"
               iyy="9.3265E-06" iyz="-6.0982E-10" izz="7.8199E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/joint5.obj" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/joint5.obj" />
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="link5">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <link name="link6">
    <inertial>
      <origin xyz="0.125725665385474 0.0139861528893371 0.0306951370138364" rpy="0 0 0" />
      <mass value="0.032788" />
      <inertia ixx="1.3335E-05" ixy="-2.5929E-08" ixz="1.6735E-08"
               iyy="1.3446E-05" iyz="2.9978E-06" izz="8.5639E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/joint6.obj" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/joint6.obj" />
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="link6">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <link name="link6_flange">
    <inertial>
      <origin xyz="-0.00740270794739872 0.00101884005958482 0.125587226035357" rpy="0 0 0" />
      <mass value="0.0077053" />
      <inertia ixx="8.4024E-07" ixy="-5.3756E-11" ixz="3.3939E-13"
               iyy="1.3552E-06" iyz="1.3104E-10" izz="8.4061E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/joint7.obj" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/collision/joint7.obj" />
      </geometry>
    </collision>
  </link>
  
  <gazebo reference="link6_flange">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <!-- Joints -->
  <joint name="link2_to_link1" type="revolute">
    <origin xyz="0 0 0.13156" rpy="0 0 1.5708" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.1416" effort="1000" velocity="2.0" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <joint name="link3_to_link2" type="revolute">
    <origin xyz= "0 0 -0.001" rpy = "0 1.5708 -1.5708"/>
    <parent link="link2" />
    <child link="link3" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.1416" effort="1000" velocity="2.0" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <joint name="link4_to_link3" type="revolute">
    <origin xyz= "-0.1104 0 0   " rpy = "0 0 0"/>
    <parent link="link3" />
    <child link="link4" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.1416" effort="1000" velocity="2.0" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <joint name="link5_to_link4" type="revolute">
    <origin xyz="-0.096 0 0.06062" rpy="0 0 -1.5708" />
    <parent link="link4" />
    <child link="link5" />
    <axis xyz="1 0 0" />
    <limit lower="-3.14" upper="3.1416" effort="1000" velocity="2.0" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <joint name="link6_to_link5" type="revolute">
    <origin xyz= "0 -0.07318 0" rpy = "1.5708 -1.5708 0"/>
    <parent link="link5" />
    <child link="link6" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.1416" effort="1000" velocity="2.0" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <joint name="link6output_to_link6" type="revolute">
    <origin xyz="0 0.0456 0" rpy="-1.5708 0 0" />
    <parent link="link6" />
    <child link="link6_flange" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14" upper="3.1416" effort="1000" velocity="2.0" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <!-- Gazebo ROS2 Control Plugin -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find myco2urdf_asm)/config/controller_config.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ROS2 Control Hardware Interface -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <joint name="link2_to_link1">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="link3_to_link2">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="link4_to_link3">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="link5_to_link4">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="link6_to_link5">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="link6output_to_link6">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>